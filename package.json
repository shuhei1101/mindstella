{
  "name": "mindmap",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p . --noEmit && tsc -p .storybook && tsc -p frontend",
    "lint": "eslint",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "storybook-react": "storybook dev -c .storybook-react -p 6007",
    "build-storybook-react": "storybook build -c .storybook-react -o storybook-react-static",
    "generate-api": "orval",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@faker-js/faker": "10.6.0",
    "@rolldown/plugin-babel": "0.3.0",
