    def save_batch(workspace: Workspace, change: BatchChange) -> None:
        """複数の種類の項目の並びと本文とまとまりを、検証してから全て書き換えるか、どれも書き換えない。"""
        kinds = [kind for kind in KINDS if kind in change.items]
