change = BatchChange(items={'decision': [{'id': 'D-1', 'title': 'D-1の題', 'status': '未決定', 'options': [{'key': 'A', 'content': '...: [], 'pending': {'added': ['D-1', 'T-1'], 'changed': []}}, removed_bodies=[], settings=None, threads=None, edits=None)

    def save_batch(workspace: Workspace, change: BatchChange) -> dict[str, str | None]:
        """複数の種類の項目の並びと本文とまとまりを、検証してから全て書き換えるか、どれも書き換えない。
    
        書いた種類の YAML と本文（記録のフォルダからのパス）→ 書いた中身（消した本文は None）を返す（変更の検知に渡す）。
        """
        kinds = [kind for kind in KINDS if kind in change.items]
        # 書き戻すと中身を失う形のファイルには書かない（変更を当てる前の、そのファイルの問題を返す）
        for kind in kinds:
            if _loses_content_on_rewrite(workspace, kind):
                file_name = KINDS[kind].file
                current = [p for p in validate_workspace(workspace) if p.file == file_name]
                raise build_mismatch_error(current, workspace)
        # 変更を当てた後のワークスペース全体を検証する
        changed_raw = {
            **workspace.raw,
            **{KINDS[kind].file: {"items": change.items[kind]} for kind in kinds},
        }
        # 設定も一緒に書くときは、新しい設定で検証する
        if change.settings is not None:
            changed_raw[SETTINGS_FILE] = change.settings
        changed = replace(workspace, raw=changed_raw)
        replaced_files = {KINDS[kind].file for kind in kinds}
        if change.settings is not None:
            replaced_files.add(SETTINGS_FILE)
        problems = validate_workspace(
            changed, unchanged=[f for f in workspace.raw if f not in replaced_files]
        )
        if problems:
            written_ids = frozenset().union(
                *(_written_ids(workspace.items[kind], change.items[kind]) for kind in kinds)
            )
