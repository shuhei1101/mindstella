{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "資料",
  "description": "`docs.yaml` の形。会話の中で作った図・文書。納品物もこの中で印を付ける。",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "description": "項目の並び（1 要素 = 1 項目）",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "title",
        "created",
        "updated",
        "kind",
        "deliverable",
        "status",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/item/properties/id",
          "pattern": "^A-[0-9]+$"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/item/properties/title"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/item/properties/target"
        },
        "category": {
          "$ref": "common.schema.json#/$defs/item/properties/category"
        },
        "phase": {
          "$ref": "common.schema.json#/$defs/item/properties/phase"
        },
        "tags": {
          "$ref": "common.schema.json#/$defs/item/properties/tags"
        },
        "attrs": {
          "$ref": "common.schema.json#/$defs/item/properties/attrs"
        },
        "related": {
          "$ref": "common.schema.json#/$defs/item/properties/related"
        },
        "links": {
          "$ref": "common.schema.json#/$defs/item/properties/links"
        },
        "created": {
          "$ref": "common.schema.json#/$defs/item/properties/created"
        },
        "updated": {
          "$ref": "common.schema.json#/$defs/item/properties/updated"
        },
        "history": {
          "$ref": "common.schema.json#/$defs/item/properties/history"
        },
        "history_dropped_seq": {
          "$ref": "common.schema.json#/$defs/item/properties/history_dropped_seq"
        },
        "kind": {
          "type": "string",
          "description": "図 / 文書 など（自由な文字列）",
          "minLength": 1
        },
        "deliverable": {
          "type": "boolean",
          "description": "ゴールでリリースする納品物か"
        },
        "status": {
          "type": "string",
          "enum": [
            "下書き",
            "確認中",
            "完成"
          ],
          "description": "資料の状態。納品物は `完成` でできたとみなす"
        },
        "body": {
          "type": "string",
          "description": "`docs/` の本文の Markdown のファイル名（`{ID}.md`）",
          "pattern": "^[^/\\\\]+\\.md$"
        }
      }
    }
  }
}
