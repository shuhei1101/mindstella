{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "資料",
  "description": "`docs.yaml` の形。会話の中で作った図・文書。",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "description": "項目の並び（1 要素 = 1 項目）",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "status",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/item/properties/id",
          "pattern": "^A-[0-9]+$"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/item/properties/title"
        },
        "tags": {
          "$ref": "common.schema.json#/$defs/item/properties/tags"
        },
        "related": {
          "$ref": "common.schema.json#/$defs/item/properties/related"
        },
        "links": {
          "$ref": "common.schema.json#/$defs/item/properties/links"
        },
        "kind": {
          "type": "string",
          "description": "図 / 文書 など（自由な文字列）",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "下書き",
            "確認中",
            "完成"
          ],
          "description": "資料の状態"
        },
        "aliases": {
          "type": "array",
          "description": "本文で一致させる語。プレビューは本文の語がこれに一致すると、用語と同じツールチップにこの資料を出す。タグ（`tags`）とは別のキー",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "description": "タイトルだけでは中身が分からないときの短い説明。ツールチップと詳細に出す"
        },
        "body": {
          "type": "string",
          "description": "本文のパス（記録のフォルダからの相対）。Markdown は `docs/{ID}.md`、HTML は `docs/{ID}.html`",
          "pattern": "^docs/[^/\\\\]+\\.(md|html)$"
        },
        "withdrawn": {
          "type": "boolean",
          "description": "やめた項目を記録に残したまま取り下げた印。取り下げていなければキーを持たない"
        },
        "reason": {
          "type": "string",
          "description": "取り下げた理由"
        }
      }
    }
  }
}
