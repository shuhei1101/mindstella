{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "調査",
  "description": "`research.yaml` の形。調べた結果。",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "description": "項目の並び（1 要素 = 1 項目）",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "title",
        "question"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/item/properties/id",
          "pattern": "^R-[0-9]+$"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/item/properties/title"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/item/properties/target"
        },
        "category": {
          "$ref": "common.schema.json#/$defs/item/properties/category"
        },
        "phase": {
          "$ref": "common.schema.json#/$defs/item/properties/phase"
        },
        "tags": {
          "$ref": "common.schema.json#/$defs/item/properties/tags"
        },
        "attrs": {
          "$ref": "common.schema.json#/$defs/item/properties/attrs"
        },
        "related": {
          "$ref": "common.schema.json#/$defs/item/properties/related"
        },
        "links": {
          "$ref": "common.schema.json#/$defs/item/properties/links"
        },
        "question": {
          "type": "string",
          "description": "何を調べたか"
        },
        "conclusion": {
          "type": "string",
          "description": "調べた結論"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "高",
            "中",
            "低"
          ],
          "description": "結論の確からしさ"
        },
        "angles": {
          "type": "array",
          "description": "調べた観点",
          "items": {
            "type": "string"
          }
        },
        "aliases": {
          "type": "array",
          "description": "本文で一致させる語。プレビューは本文の語がこれに一致すると、用語と同じツールチップにこの調査を出す。タグ（`tags`）とは別のキー",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "description": "タイトルだけでは中身が分からないときの短い説明。ツールチップと詳細に出す"
        },
        "body": {
          "type": "string",
          "description": "本文の Markdown のパス（記録のフォルダからの相対。`docs/{ID}.md`）",
          "pattern": "^docs/[^/\\\\]+\\.md$"
        },
        "withdrawn": {
          "type": "boolean",
          "description": "やめた項目を記録に残したまま取り下げた印。取り下げていなければキーを持たない"
        },
        "reason": {
          "type": "string",
          "description": "取り下げた理由"
        }
      }
    }
  }
}
