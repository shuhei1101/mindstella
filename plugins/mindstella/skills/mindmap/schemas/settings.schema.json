{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "設定",
  "description": "`config.yaml` の形。ワークスペースの ID・進め方の文書・題名・話し合いの概要・関連する場所・変更履歴を保持する回数・表示の既定・プレビューの配信のポートを持つ。",
  "type": "object",
  "required": [
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "ワークスペースの ID（project-index の配信元の行の `id`。`mindstella-{フォルダ名}-{ハッシュ}`）。常駐サーバーの API で作ったワークスペースだけが持つ",
      "minLength": 1
    },
    "flow": {
      "type": "object",
      "description": "進め方の文書（project-index の配信元の ID と文書の ID）。MindStella のセッションの SessionStart のフックが場所を注入する",
      "required": [
        "source",
        "doc"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "doc": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "links": {
      "type": "array",
      "description": "関連する場所",
      "items": {
        "type": "object",
        "description": "リンク 1 件",
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "description": "リンクのタイトル"
          },
          "url": {
            "type": "string",
            "description": "リンク先の URL"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "話し合いのタイトル（何についての話し合いかを 1 文で）。プレビューのトップバーに出す",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "話し合いの概要（何についての話し合いかを 1 文の短い文で）。プレビューの概要の画面の題名の上に出す。題名（`summary`）とは別のもの",
      "maxLength": 60,
      "minLength": 1
    },
    "history_limit": {
      "type": "integer",
      "description": "項目ごとに変更履歴を何回分持つか。0 以上の整数で上限は設けない。0 は変更履歴を持たず、差分を出さない。無ければ 5。`update_settings` で変える。AI がまだ読んでいない回（`changes.yaml` の `read_seq` より後の回）は、この回数を超えても消さない",
      "minimum": 0
    },
    "display": {
      "type": "object",
      "description": "プレビューのワークスペースの既定。利用者の個人の上書き（ブラウザの `localStorage`）が無い項目に使う。`update_settings` と、プレビューの「ワークスペースの既定にする」が書く",
      "additionalProperties": false,
      "properties": {
        "visible_kinds": {
          "type": "array",
          "description": "プレビューのタブに出す種類。無ければ全ての種類。概要は常に出す",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "decisions",
              "tasks",
              "research",
              "docs",
              "terms",
              "notes",
              "logs"
            ]
          }
        }
      }
    },
    "confirm_on_comment": {
      "type": "boolean",
      "description": "コメントをまとめて送る・すぐ送るときに、送ったコメントが向いた項目を確認済み（`history.yaml` の `confirmed`）にするか。無ければ `true`。`update_settings` と、プレビューの設定の画面が書く"
    },
    "transcription": {
      "type": "object",
      "description": "コメント・返信の入力の音声入力の設定。どの文字起こしのサービスを使うかは持たない（常駐サーバーの環境変数 `MINDSTELLA_TRANSCRIBER`）。`update_settings` と、プレビューの設定の画面が書く",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "description": "文字起こし後の挙動。`review` は入力欄へ挿入した全文をレビュー中に溜めて送信しない。`send` は入力欄へ挿入した全文をその 1 件だけで Claude Code へ送信し、`insert` はカーソルの位置に挿入して送信しない。無ければ `review`",
          "enum": [
            "review",
            "send",
            "insert"
          ]
        },
        "preset": {
          "type": [
            "string",
            "null"
          ],
          "description": "文字起こしのサービスへ渡す用語集のプリセットの名前。無いか `null` ならサービスの既定",
          "minLength": 1
        }
      }
    },
    "mdmark": {
      "type": "object",
      "description": "画面・Storybook・配る書き出しが読み込む mdmark。`version` は `update_settings` が書き、`map` は移し替えの手順だけが書く。設定の再読み込みの後に開いた画面から効く",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "description": "読み込む mdmark のバージョン。`latest`（jsDelivr の `gh/shuhei1101/mdmark@develop`）か `v{数字}.{数字}.{数字}` のタグ。無ければ `latest`",
          "pattern": "^(latest|v[0-9]+\\.[0-9]+\\.[0-9]+)$"
        },
        "map": {
          "type": "object",
          "description": "map の図の種類。mdmark の設定の `map` と同じ形の `kinds`・`lines`。画面が `mount` の `config.map` に指定する"
        }
      }
    },
    "presets": {
      "type": "array",
      "description": "絞り込みのプリセットの並び。プリセットの作成・更新・削除のツールが書く",
      "items": {
        "type": "object",
        "description": "プリセット 1 件",
        "required": [
          "name",
          "filter"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "名前。プリセットの間で重ならない（NFKC と大文字小文字をそろえて比べる）"
          },
          "description": {
            "type": "string",
            "description": "何を開くプリセットかを 1 文で"
          },
          "filter": {
            "$ref": "#/$defs/preset_filter"
          }
        }
      }
    }
  },
  "$defs": {
    "preset_filter": {
      "description": "タグの式。条件か `and`・`or`・`not` の束（入れ子の深さと空の束は presets.py が確かめる）",
      "oneOf": [
        {
          "$ref": "#/$defs/preset_condition"
        },
        {
          "type": "object",
          "required": [
            "and"
          ],
          "additionalProperties": false,
          "properties": {
            "and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/preset_filter"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "or"
          ],
          "additionalProperties": false,
          "properties": {
            "or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/preset_filter"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "properties": {
            "not": {
              "$ref": "#/$defs/preset_filter"
            }
          }
        }
      ]
    },
    "preset_condition": {
      "type": "object",
      "description": "タグの条件 1 件",
      "required": [
        "field",
        "op",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "const": "tags",
          "description": "比べる項目。タグだけ"
        },
        "op": {
          "enum": [
            "eq",
            "ne"
          ],
          "description": "`eq` は選んだタグを持つ、`ne` は選んだタグをどれも持たない"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "選んだタグ"
        },
        "match": {
          "enum": [
            "any",
            "all"
          ],
          "description": "`eq` で、選んだタグのどれか（`any`。既定）か全て（`all`）を持つか"
        }
      }
    }
  }
}
