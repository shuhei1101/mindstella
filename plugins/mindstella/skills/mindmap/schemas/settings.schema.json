{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "設定",
  "description": "`config.yaml` の形。題名・話し合いの概要・プレイブック・最上位の軸の呼び名・フェーズ・対象とカテゴリー・ゴール・関連する場所・変更履歴を保持する回数・表示の既定を持つ。",
  "type": "object",
  "required": [
    "playbooks",
    "target_label",
    "phases",
    "targets",
    "categories",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "playbooks": {
      "type": "array",
      "description": "並べて使う進め方ガイドの名前（例 `[壁打ち, システム開発]`）。1 件以上で、重複しない",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_label": {
      "type": "string",
      "description": "最上位の軸（対象）を画面で何と呼ぶか（例 `システム`）",
      "minLength": 1
    },
    "phases": {
      "type": "array",
      "description": "フェーズの名前を浅い順に並べる。プレイブックを複数並べても 1 本の並びで持つ。`next` の並べ替えはこの順を使う",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targets": {
      "type": "array",
      "description": "対象の一覧",
      "items": {
        "type": "object",
        "required": [
          "name",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "対象の名前",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "description": "対象の概要"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "description": "カテゴリーの一覧",
      "items": {
        "type": "object",
        "required": [
          "name",
          "target",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "カテゴリーの名前",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "description": "属する対象。`targets[].name` のどれか"
          },
          "summary": {
            "type": "string",
            "description": "カテゴリーの概要"
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "description": "ゴール。無いときは、ゴールを決めていない話し合い",
      "required": [
        "phase",
        "summary",
        "deliverables"
      ],
      "additionalProperties": false,
      "properties": {
        "phase": {
          "type": "string",
          "description": "どのフェーズまでやるか。`phases` のどれか"
        },
        "summary": {
          "type": "string",
          "description": "ゴールの概要"
        },
        "deliverables": {
          "type": "array",
          "description": "リリースする納品物",
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "description": "納品物のタイトル"
              },
              "doc": {
                "type": "string",
                "description": "できた資料の ID（`A-`）",
                "pattern": "^A-[0-9]+$"
              }
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "description": "関連する場所",
      "items": {
        "type": "object",
        "description": "リンク 1 件",
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "description": "リンクのタイトル"
          },
          "url": {
            "type": "string",
            "description": "リンク先の URL"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "話し合いのタイトル（何についての話し合いかを 1 文で）。プレビューのトップバーに出す",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "話し合いの概要（何についての話し合いかを 1 文の短い文で）。プレビューの概要の画面の題名の上に出す。題名（`summary`）・ゴールの概要（`goal.summary`）とは別のもの",
      "maxLength": 60,
      "minLength": 1
    },
    "history_limit": {
      "type": "integer",
      "description": "項目ごとに変更履歴を何回分持つか。0 以上の整数で上限は設けない。0 は変更履歴を持たず、差分を出さない。無ければ 5。`update_settings` で変える。AI がまだ読んでいない回（`changes.yaml` の `read_seq` より後の回）は、この回数を超えても消さない",
      "minimum": 0
    },
    "display": {
      "type": "object",
      "description": "プレビューのワークスペースの既定。利用者の個人の上書き（ブラウザの `localStorage`）が無い項目に使う。`update_settings` と、プレビューの「ワークスペースの既定にする」が書く",
      "additionalProperties": false,
      "properties": {
        "network_look": {
          "type": "string",
          "description": "ネットワークの見た目。無ければ `deep`",
          "enum": [
            "glow",
            "starlight",
            "constellation",
            "deep",
            "dust"
          ]
        },
        "visible_kinds": {
          "type": "array",
          "description": "プレビューのタブに出す種類。無ければ全ての種類。概要とネットワークは常に出す",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "decisions",
              "tasks",
              "research",
              "docs",
              "terms",
              "notes",
              "logs"
            ]
          }
        }
      }
    }
  }
}
