{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "タスク",
  "description": "`tasks.yaml` の形。検討事項を決めるための作業と「後でやっといて」。消さず、状態を `中止` にする。",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "description": "項目の並び（1 要素 = 1 項目）",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "title",
        "created",
        "updated",
        "kind",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/item/properties/id",
          "pattern": "^T-[0-9]+$"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/item/properties/title"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/item/properties/target"
        },
        "category": {
          "$ref": "common.schema.json#/$defs/item/properties/category"
        },
        "phase": {
          "$ref": "common.schema.json#/$defs/item/properties/phase"
        },
        "tags": {
          "$ref": "common.schema.json#/$defs/item/properties/tags"
        },
        "attrs": {
          "$ref": "common.schema.json#/$defs/item/properties/attrs"
        },
        "related": {
          "$ref": "common.schema.json#/$defs/item/properties/related"
        },
        "links": {
          "$ref": "common.schema.json#/$defs/item/properties/links"
        },
        "created": {
          "$ref": "common.schema.json#/$defs/item/properties/created"
        },
        "updated": {
          "$ref": "common.schema.json#/$defs/item/properties/updated"
        },
        "history": {
          "$ref": "common.schema.json#/$defs/item/properties/history"
        },
        "history_dropped_seq": {
          "$ref": "common.schema.json#/$defs/item/properties/history_dropped_seq"
        },
        "seq": {
          "$ref": "common.schema.json#/$defs/item/properties/seq"
        },
        "added_seq": {
          "$ref": "common.schema.json#/$defs/item/properties/added_seq"
        },
        "kind": {
          "type": "string",
          "enum": [
            "作業",
            "調査",
            "検証"
          ],
          "description": "種類"
        },
        "status": {
          "type": "string",
          "enum": [
            "未着手",
            "進行中",
            "保留",
            "完了",
            "中止"
          ],
          "description": "状態"
        },
        "for": {
          "type": "array",
          "description": "このタスクが進める検討事項の ID（`D-`）",
          "items": {
            "type": "string",
            "pattern": "^D-[0-9]+$"
          }
        },
        "depends_on": {
          "type": "array",
          "description": "先に終わっている必要があるタスクの ID（`T-`）",
          "items": {
            "type": "string",
            "pattern": "^T-[0-9]+$"
          }
        },
        "reason": {
          "type": "string",
          "description": "積んだ理由・保留や中止の理由"
        },
        "result": {
          "type": "string",
          "description": "終えたときの結果"
        }
      }
    }
  }
}
