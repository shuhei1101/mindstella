{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "共通のキー",
  "description": "種類ごとの YAML の項目が共通で持つキー。各種類のスキーマが `$ref` で指す。",
  "$defs": {
    "link": {
      "type": "object",
      "description": "リンク 1 件",
      "required": [
        "title",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "リンクのタイトル"
        },
        "url": {
          "type": "string",
          "description": "リンク先の URL"
        }
      }
    },
    "item": {
      "type": "object",
      "description": "全ての種類の項目が持つキー（作成日時・更新日時・編集した人・通し番号・変更履歴は項目に持たず `history.yaml` に持つ）",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "ID。種類の頭の文字 + `-` + 連番（例 `D-12`）。スクリプトが付ける",
          "pattern": "^[A-Z]-[0-9]+$"
        },
        "title": {
          "type": "string",
          "description": "タイトル",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "description": "対象。設定の `targets[].name` のどれか"
        },
        "category": {
          "type": "string",
          "description": "カテゴリー。設定の `categories[].name` のどれか"
        },
        "phase": {
          "type": "string",
          "description": "フェーズ。設定の `phases` のどれか"
        },
        "tags": {
          "type": "array",
          "description": "話題のタグ。要素は `{name, main?}`。`name` はどの文字列でも持て、`tags` のツールが NFKC と小文字にそろえた表記で数える。その項目の主題のタグだけが `main: true` を持つ",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "タグの名前（書いたときの表記）"
              },
              "main": {
                "type": "boolean",
                "description": "その項目の主題のタグなら true"
              }
            }
          }
        },
        "attrs": {
          "type": "object",
          "description": "自由なキーと値。値は文字列・数値・真偽値。使っているキーの名前は `attrs` のコマンドで引く",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "related": {
          "type": "array",
          "description": "関連する項目。要素は `{to, type}`。`type` は `depends_on`（先に決まっている必要がある項目。保留の待ち先も持つ）・`parent`（派生元）・`for`（タスクが進める検討事項）・`see_also`（向きを持たない関連。影響をたどらない）",
          "items": {
            "type": "object",
            "required": [
              "to",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "to": {
                "type": "string",
                "description": "指す項目の ID",
                "pattern": "^[A-Z]-[0-9]+$"
              },
              "type": {
                "type": "string",
                "description": "関連の種類",
                "enum": [
                  "depends_on",
                  "parent",
                  "for",
                  "see_also"
                ]
              }
            }
          }
        },
        "links": {
          "type": "array",
          "description": "リンク",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    }
  }
}
