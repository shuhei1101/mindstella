{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "共通のキー",
  "description": "種類ごとの YAML の項目が共通で持つキー。各種類のスキーマが `$ref` で指す。",
  "$defs": {
    "link": {
      "type": "object",
      "description": "リンク 1 件",
      "required": [
        "title",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "リンクのタイトル"
        },
        "url": {
          "type": "string",
          "description": "リンク先の URL"
        }
      }
    },
    "item": {
      "type": "object",
      "description": "全ての種類の項目が持つキー",
      "required": [
        "id",
        "title",
        "created",
        "updated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "ID。種類の頭の文字 + `-` + 連番（例 `D-12`）。スクリプトが付ける",
          "pattern": "^[A-Z]-[0-9]+$"
        },
        "title": {
          "type": "string",
          "description": "タイトル",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "description": "対象。設定の `targets[].name` のどれか"
        },
        "category": {
          "type": "string",
          "description": "カテゴリー。設定の `categories[].name` のどれか"
        },
        "phase": {
          "type": "string",
          "description": "フェーズ。設定の `phases` のどれか"
        },
        "tags": {
          "type": "array",
          "description": "タグ（自由な文字列）",
          "items": {
            "type": "string"
          }
        },
        "attrs": {
          "type": "object",
          "description": "自由なキーと値。値は文字列・数値・真偽値。使っているキーの名前は `attrs` のコマンドで引く",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "related": {
          "type": "array",
          "description": "関連する項目の ID。向きを持たず、`impact` はたどらない",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]-[0-9]+$"
          }
        },
        "links": {
          "type": "array",
          "description": "リンク",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "created": {
          "type": "string",
          "description": "作成日時。UTC のタイムゾーン付き ISO 8601。スクリプトが付ける",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(\\+00:00|Z)$"
        },
        "updated": {
          "type": "string",
          "description": "更新日時。UTC のタイムゾーン付き ISO 8601。スクリプトが付ける",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(\\+00:00|Z)$"
        },
        "history": {
          "$ref": "#/$defs/history"
        },
        "history_dropped_seq": {
          "type": "integer",
          "minimum": 1,
          "description": "保持する回数を超えて `history` から消した要素のうち、最も大きい `seq`。消すたびに大きい方へ書き換え、一度も消していなければ持たない。ツールが付ける"
        }
      }
    },
    "history": {
      "type": "array",
      "description": "変更履歴。`update`・`adopt` が値を変えるたびに先頭に 1 要素を足し、新しい順に並べる。数は設定の `history_limit` まで。ツールが付ける",
      "items": {
        "type": "object",
        "description": "変更履歴の 1 回分",
        "required": [
          "seq",
          "at",
          "before"
        ],
        "additionalProperties": false,
        "properties": {
          "seq": {
            "type": "integer",
            "description": "`changes.yaml` の通し番号",
            "minimum": 1
          },
          "at": {
            "type": "string",
            "description": "書き換えた日時。UTC のタイムゾーン付き ISO 8601",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(\\+00:00|Z)$"
          },
          "before": {
            "type": "object",
            "description": "変わったキー → 書き換える前の値。前に無かったキーは null。`updated`・`history`・`history_dropped_seq`・`body` は入れない"
          },
          "body_diff": {
            "type": "array",
            "description": "本文が変わったときだけ持つ。今の本文を前の本文へ戻す、行の置き換えの並び（行の位置の小さい順）",
            "items": {
              "type": "object",
              "required": [
                "line",
                "now",
                "before"
              ],
              "additionalProperties": false,
              "properties": {
                "line": {
                  "type": "integer",
                  "description": "その書き換えの後の本文の 1 始まりの行。`now` が空のときはその行の前に差し込む",
                  "minimum": 1
                },
                "now": {
                  "type": "array",
                  "description": "その行からの今の行（改行を含まない）",
                  "items": {
                    "type": "string"
                  }
                },
                "before": {
                  "type": "array",
                  "description": "置き換える前の行",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
