{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${MINDSTELLA_VENV:-$HOME/.mindmap/venv}/bin/python\" \"${CLAUDE_PLUGIN_ROOT}/skills/mindmap/scripts/reset_unread.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/mindmap/scripts/ensure_server.py\" --hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_mindstella_mindstella__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/mindmap/scripts/inject_session.py\""
          }
        ]
      }
    ]
  }
}
