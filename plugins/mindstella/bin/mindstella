#!/usr/bin/env bash
# mindstella の常駐サーバーが落ちていれば起動してから、ワークスペースと MindStella のセッションを作り、そのペインへつなぐ。
# 使い方:
#   {プラグインのフォルダ}/bin/mindstella {ワークスペースのフォルダ} [--flow {配信元の ID}#{文書の ID}] [--mcp-config {ファイル}] [--plugin-dir {フォルダ}]...
#   {プラグインのフォルダ}/bin/mindstella server {status|stop|restart}
# 環境変数:
#   MINDSTELLA_VENV    常駐サーバーを動かす仮想環境のフォルダ（既定は ~/.mindmap/venv）
#   MINDSTELLA_PORT    常駐サーバーの待ち受けのポート（既定は 8784）
#   CLAUDE_CONFIG_DIR  あれば、claude-balancer が無い端末で MindStella のセッションの Claude Code の設定のフォルダ（アカウント）にする
#   MINDSTELLA_ALLOWED_HOSTS / MINDSTELLA_PREVIEW_START_HOOK / MINDSTELLA_PREVIEW_STOP_HOOK /
#   MINDSTELLA_TRANSCRIBER / MINDSTELLA_TRANSCRIBER_URL / PROJECT_INDEX_PORT
#                      あれば、常駐サーバーを起動するときにユニットの Environment= に書いて渡す
# 終了コード: 0 正常 / 1 実行時のエラー / 2 引数の誤り
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$SCRIPT_DIR/../skills/mindmap/scripts"

# 標準エラーに出すエラーの行の頭
ERROR_PREFIX="[mindstella] エラー:"

# 常駐サーバーの systemd --user のユニット
UNIT_NAME="mindstella.service"

# 使い方を標準エラーに出して、終了コード 2 で終わる
usage() {
  echo "使い方: $0 {ワークスペースのフォルダ} [--flow {配信元の ID}#{文書の ID}] [--mcp-config {ファイル}] [--plugin-dir {フォルダ}]..." >&2
  echo "        $0 server {status|stop|restart}" >&2
  exit 2
}

# エラーを標準エラーに出して、終了コード 1 で終わる（2 つ目の引数があれば次の行に添える）
fail() {
  echo "$ERROR_PREFIX $1" >&2
  if [ "$#" -ge 2 ] && [ -n "$2" ]; then
    echo "$2" >&2
  fi
  exit 1
}

# 依存の確認の結果（JSON）から、値を取り出す。標準ライブラリだけで読み、jq に頼らない
#   python_path: MCP サーバーを動かす Python / install: そろえるコマンド / summary: 足りないものの説明
read_report() {
  python3 -c '
import json, sys

report = json.load(sys.stdin)
item = sys.argv[1]
if item == "python_path":
    print(report.get("python_path", ""))
elif item == "install":
    print(report.get("install") or "")
else:
    lines = []
    if not report.get("venv_ok"):
        lines.append("仮想環境がありません: " + report.get("venv", ""))
    elif not report.get("python_ok"):
        lines.append("仮想環境の Python が下限より古いか、版を引けません: " + report.get("venv", ""))
    for package in report.get("packages", []):
        if not package.get("ok"):
            lines.append("ライブラリが足りません: %s（%s 以上）" % (package["name"], package["required"]))
    if not report.get("install"):
        lines.append("そろえるコマンドを作れません。Python 3.12 以上を入れてください")
    print("\n".join(lines))
' "$1"
}

# 1. 引数: ワークスペースのフォルダと付ける引数か、server のサブコマンドを受け取る
[ "$#" -ge 1 ] && [ -n "$1" ] || usage
SERVER_COMMAND=""
if [ "$1" = "server" ]; then
  [ "$#" -eq 2 ] || usage
  case "$2" in
    status | stop | restart) SERVER_COMMAND="$2" ;;
    *) usage ;;
  esac
fi

# 停止: systemd --user のユニットを止めるだけ（依存もプラグインも確かめない）
if [ "$SERVER_COMMAND" = "stop" ]; then
  systemctl --user stop "$UNIT_NAME" || fail "systemctl --user stop $UNIT_NAME が失敗しました"
  echo "[mindstella] 常駐サーバーを止めました" >&2
  exit 0
fi

# 2. 依存: システムの python3 で依存の確認を起動する
command -v python3 >/dev/null 2>&1 || fail "python3 が見つかりません。Python 3.12 以上を入れてください"
VENV_ARGS=()
if [ -n "${MINDSTELLA_VENV:-}" ]; then
  VENV_ARGS=(--venv "$MINDSTELLA_VENV")
fi
set +e
REPORT="$(python3 "$SCRIPTS_DIR/check_env.py" ${VENV_ARGS[@]+"${VENV_ARGS[@]}"} 2>/dev/null)"
CHECK_STATUS=$?
set -e
# 結果を JSON として読めない: 依存の確認そのものが動かなかった
if [ -z "$REPORT" ]; then
  fail "依存を確かめられませんでした。python3 は 3.8 以上が要ります"
fi
if [ "$CHECK_STATUS" -ne 0 ]; then
  DETAIL="$(read_report summary <<<"$REPORT")"
  INSTALL_COMMAND="$(read_report install <<<"$REPORT")"
  # そろえるコマンドがあれば、説明の次の行に添える
  if [ -n "$INSTALL_COMMAND" ]; then
    DETAIL="$DETAIL"$'\n'"$INSTALL_COMMAND"
  fi
  fail "依存が足りません" "$DETAIL"
fi
PYTHON_PATH="$(read_report python_path <<<"$REPORT")"

# 状態: 常駐サーバーの状態を出す
if [ "$SERVER_COMMAND" = "status" ]; then
  exec "$PYTHON_PATH" "$SCRIPTS_DIR/launch.py" --server-status
fi

# 3. tmux と Claude Code
command -v tmux >/dev/null 2>&1 || fail "tmux が見つかりません。tmux を入れてください"
command -v claude >/dev/null 2>&1 || fail "claude が見つかりません。Claude Code を入れてください"

# 4. プラグインのフォルダ: インストールした今の版のフォルダを引く
LISTING="$(claude plugin list --json)" || fail "claude plugin list --json を実行できません"
PLUGIN_DIR="$("$PYTHON_PATH" "$SCRIPTS_DIR/launch.py" --find-plugin <<<"$LISTING")" || exit 1
echo "[mindstella] プラグイン: $PLUGIN_DIR" >&2

# 起動し直し: インストールした今の版のフォルダでユニットを書き直して起動し直す
if [ "$SERVER_COMMAND" = "restart" ]; then
  exec python3 "$PLUGIN_DIR/skills/mindmap/scripts/ensure_server.py" --restart
fi

# 5. 常駐サーバー: インストールした今の版の起動の確認で、落ちていれば起動する（案内は標準エラーに出る）
python3 "$PLUGIN_DIR/skills/mindmap/scripts/ensure_server.py" || exit 1

# 6. ワークスペースと MindStella のセッション: 画面の URL とペインを 1 行ずつ受ける
STARTED="$("$PYTHON_PATH" "$PLUGIN_DIR/skills/mindmap/scripts/launch.py" --start "$@")" || exit $?
{
  IFS= read -r URL
  IFS= read -r PANE
} <<<"$STARTED"
SESSION="${PANE%%:*}"

# 7. つなぐ: 標準出力が端末のときだけつなぎ、端末でなければ画面の URL とつなぐコマンドを出して終わる
echo "$URL"
if [ -t 1 ]; then
  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "=$SESSION"
  fi
  exec tmux attach-session -t "=$SESSION"
fi
if [ -n "${TMUX:-}" ]; then
  echo "tmux switch-client -t =$SESSION"
else
  echo "tmux attach-session -t =$SESSION"
fi
