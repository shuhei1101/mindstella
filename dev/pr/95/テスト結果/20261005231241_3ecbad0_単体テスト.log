# 外すプラグイン（deselect_red.py）
"""Red の単体テストの node id（ファイル RED_IDS_FILE に 1 行 1 件）を、収集の後に外す pytest プラグイン。"""

import os
from pathlib import Path


def pytest_collection_modifyitems(config, items):
    """node id が一覧にあるテストを、実行する対象から外す。"""
    red = set(Path(os.environ["RED_IDS_FILE"]).read_text(encoding="utf-8").split("\n"))
    kept = [item for item in items if item.nodeid not in red]
    config.hook.pytest_deselected(items=[item for item in items if item.nodeid in red])
    items[:] = kept
